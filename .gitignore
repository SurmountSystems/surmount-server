# Build artifacts
result
result-*
crates/target/
*.rmeta
*.rlib

# Editor / OS
.DS_Store
*~
*.swp

# Local agent session reports / plans (not product). May name private
# host work; never part of the public commit surface.
.agents/

# Local secrets (never commit plaintext)
secrets/**/*.decrypted.*
.env
.env.*

# Private host-local overlay (hardware, SSH pubs, net, real hostname).
# Never commit. Flake auto-imports when present (path flake / deploy rsync).
# See docs/deploy-host-local.md.
/host-local/

# sops age keys must never land in the repo
keys.txt
*.agekey
