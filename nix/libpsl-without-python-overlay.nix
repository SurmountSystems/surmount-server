# libpsl 0.23.3 from the upstream release tarball. The builder is that
# tarball's ./configure and make. This is not the GitHub tag, and it is
# not the meson build.
#
# Release asset (verified on the 0.23.3 release, asset name
# libpsl-0.23.3.tar.gz):
# https://github.com/rockdaboot/libpsl/releases/download/0.23.3/libpsl-0.23.3.tar.gz
# nix hash file --type sha256 --sri of that download:
# sha256-k5QfhaHnvVk/qU8pkjPLXfyRzRRP2aeKbOt1ABxbA74=
#
# configure.ac calls AM_PATH_PYTHON only when src/suffixes_dafsa.h,
# tests/psl.dafsa, or tests/psl_ascii.dafsa is missing. The tarball
# ships all three. src/Makefile.am rebuilds suffixes_dafsa.h only when
# $(PSL_FILE) or src/psl-make-dafsa is newer than that header. In this
# tarball, list/public_suffix_list.dat and src/psl-make-dafsa are both
# older than src/suffixes_dafsa.h. Do not pass --with-psl-file. A newer
# list would make that recipe run.
final: prev: {
  libpsl = prev.libpsl.overrideAttrs (old: {
    src = prev.fetchurl {
      url = "https://github.com/rockdaboot/libpsl/releases/download/0.23.3/libpsl-0.23.3.tar.gz";
      hash = "sha256-k5QfhaHnvVk/qU8pkjPLXfyRzRRP2aeKbOt1ABxbA74=";
    };

    # pkg-config finds libidn2. gettext supplies msgfmt for po/.
    # No meson, ninja, gtk-doc, python, python3, or python3Minimal.
    nativeBuildInputs = [
      prev.pkg-config
      prev.gettext
    ];

    buildInputs = [
      prev.libidn2
      prev.libunistring
    ];

    # Drop the GitHub meson options. They are not configure flags.
    # Leaving them set would still name a publicsuffix path.
    mesonFlags = [ ];

    # Do not point configure at another public suffix list.
    configureFlags = [ ];

    # Makefile.in was generated by automake 1.18.1. configure substitutes
    # ACLOCAL to build-aux/missing aclocal-1.18. This nixpkgs automake is
    # 1.19 (aclocal and aclocal-1.19). It does not install aclocal-1.18.
    # automake118x is gone. Do not add that automake.
    #
    # The mail-host overlay appends another postPatch that rewrites
    # configure.ac and Makefile.am. Those files then become newer than
    # aclocal.m4, and make runs Makefile:510. This postPatch runs first.
    # It replaces the maintainer recipes in the shipped Makefile.in.
    # A touch here would be too early. preConfigure stamps the generated
    # files after that later rewrite. preBuild patches the Makefile that
    # configure wrote, which is the one make runs.
    postPatch = ''
      neutralize_maintainer() {
        src="$1"
        if [ ! -f "$src" ]; then
          return 0
        fi
        awk '
          {
            if ($0 ~ /\$\((ACLOCAL|AUTOCONF|AUTOHEADER|AUTOMAKE)\)/ && $0 !~ /echo/) {
              if ($0 ~ /\\[[:space:]]*$/) {
                print "\t: \\"
              } else {
                print "\t:"
              }
              next
            }
            print
          }
        ' "$src" > "$src.nomaint"
        mv "$src.nomaint" "$src"
      }
      find . -type f -name Makefile.in > "$NIX_BUILD_TOP/libpsl-makefile-in"
      while IFS= read -r mk; do
        neutralize_maintainer "$mk"
      done < "$NIX_BUILD_TOP/libpsl-makefile-in"
    '';

    # Runs after the appended postPatch has rewritten configure.ac
    # and Makefile.am. The shipped aclocal.m4, configure, config.h.in,
    # and Makefile.in stay newer than those inputs, so make does not
    # need build-aux/missing.
    preConfigure = ''
      touch aclocal.m4 configure config.h.in
      find . -type f -name Makefile.in > "$NIX_BUILD_TOP/libpsl-makefile-in-stamp"
      while IFS= read -r mk; do
        touch "$mk"
      done < "$NIX_BUILD_TOP/libpsl-makefile-in-stamp"
    '';

    preBuild = ''
      neutralize_maintainer() {
        src="$1"
        if [ ! -f "$src" ]; then
          return 0
        fi
        awk '
          {
            if ($0 ~ /\$\((ACLOCAL|AUTOCONF|AUTOHEADER|AUTOMAKE)\)/ && $0 !~ /echo/) {
              if ($0 ~ /\\[[:space:]]*$/) {
                print "\t: \\"
              } else {
                print "\t:"
              }
              next
            }
            print
          }
        ' "$src" > "$src.nomaint"
        mv "$src.nomaint" "$src"
      }
      find . -type f -name Makefile > "$NIX_BUILD_TOP/libpsl-makefile"
      while IFS= read -r mk; do
        neutralize_maintainer "$mk"
        if awk '/\$\((ACLOCAL|AUTOCONF|AUTOHEADER|AUTOMAKE)\)/ && $0 !~ /echo/ { found = 1 } END { exit found ? 0 : 1 }' "$mk"; then
          echo "maintainer recipe still present in $mk" >&2
          exit 1
        fi
      done < "$NIX_BUILD_TOP/libpsl-makefile"
      touch aclocal.m4
    '';

    doCheck = false;
  });
}
